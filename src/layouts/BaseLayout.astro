---
import { siteConfig } from '../config/site';

import '../styles/reset.css';
import '../styles/global.scss';

import Background from '../components/common/Background.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Seo from '../components/common/Seo.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  lang = siteConfig.lang,
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;

---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="format-detection" content="telephone=no" />

		<Seo {title} {description} {ogImage} {ogType} {noindex} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=M+PLUS+1p&family=Yomogi&family=Yuji+Syuku&display=swap" rel="stylesheet" />
	</head>
	<body>
    <Background />
		<Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/animation';
    </script>
	</body>
</html>

<style lang="scss">
    @use "../styles/variables" as *;
    @use "../styles/mixins" as *;

    main {
      position: relative;
      z-index: 1;
    }
</style>
