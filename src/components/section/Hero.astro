---
import { getImage } from 'astro:assets';

import pcHero from '../../assets/images/pc-hero.png';
import tabHero from '../../assets/images/tab-hero.png';
import spHero from '../../assets/images/sp-hero.png';

const pc = await getImage({ src: pcHero, format: 'webp' });
const tab = await getImage({ src: tabHero, format: 'webp' });
const sp = await getImage({ src: spHero, format: 'webp' });
---
<section class="hero">
    <picture class="hero-picture">
      <source media="(max-width: 500px)" srcset={sp.src} type="image/webp" width={spHero.width} height={spHero.height} />
      <source media="(max-width: 768px)" srcset={tab.src} type="image/webp" width={tabHero.width} height={tabHero.height} />
      <img
        src={pc.src}
        alt=""
        width={pcHero.width}
        height={pcHero.height}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  .hero {
    width: 100%;
    height: 100dvh;
  }

  .hero-picture {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
